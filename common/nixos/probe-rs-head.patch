+/// Returns `true` if `serial` looks like an XVC server address
+/// (`<host>` or `<host>:<port>`, IPv6 optionally bracketed).
+///
+/// Other probe types that have no USB identity (e.g. the Linux GPIO
+/// bit-bang probe) share the `0000:0000` placeholder ID, so a non-address
+/// serial must not be claimed by the XVC factory.
+fn is_xvc_address(serial: &str) -> bool {
+    // Drop a trailing numeric port, except for bracketed IPv6 literals.
+    let host = if serial.contains('[') {
+        serial
+    } else if let Some((host, port)) = serial.rsplit_once(':') {
+        if !port.bytes().all(|b| b.is_ascii_digit()) {
+            return false;
+        }
+        host
+    } else {
+        serial
+    };
+    !host.is_empty()
+        && host
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'-' | b'_' | b'[' | b']' | b':'))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn xvc_address_accepts_hosts_and_ports() {
+        for address in ["localhost", "192.168.1.123", "192.168.1.123:2542", "[::1]:2542"] {
+            assert!(is_xvc_address(address), "{address} should be an address");
+        }
+    }
+
+    #[test]
+    fn xvc_address_rejects_non_addresses() {
+        // e.g. a Linux GPIO bit-bang pin map, which also selects via 0000:0000
+        for address in ["", "gpiochip1,swclk=26,swdio=25,srst=31", "host:not-a-port"] {
+            assert!(!is_xvc_address(address), "{address} is not an address");
+        }
+    }
+}
