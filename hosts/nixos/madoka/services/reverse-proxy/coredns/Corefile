. {
    errors
    cancel

    bind 0.0.0.0

    template IN A milkjar.madoka {
        match .*\.milkjar\.madoka
        answer "{{ .Name }} 60 IN A {$MAIN_NODE_IP}"
        fallthrough
    }

    hosts {
        {$TAILSCALE_NODE_IP} jellyfin.madoka
        {$TAILSCALE_NODE_IP} radarr.madoka
        {$TAILSCALE_NODE_IP} sonarr.madoka
        {$TAILSCALE_NODE_IP} animarr.madoka
        {$TAILSCALE_NODE_IP} radanimarr.madoka
        {$TAILSCALE_NODE_IP} jackett.madoka
        {$TAILSCALE_NODE_IP} torrent.madoka
        {$TAILSCALE_NODE_IP} mediaserver.madoka
        {$TAILSCALE_NODE_IP} prowlarr.madoka
        {$TAILSCALE_NODE_IP} animlarr.madoka
        {$TAILSCALE_NODE_IP} oauth.madoka
		{$TAILSCALE_NODE_IP} lidarr.madoka
        {$MAIN_NODE_IP} cert.madoka
        {$MAIN_NODE_IP} gitea.madoka
        {$MAIN_NODE_IP} acme.madoka
        {$MAIN_NODE_IP} milkjar.madoka
        {$MAIN_NODE_IP} calico.madoka
        {$MAIN_NODE_IP} meow.madoka
        {$TAILSCALE_NODE_IP} milkjar.madoka
        fallthrough
    }

    forward . tls://1.1.1.1 tls://1.0.0.1 tls://2606:4700:4700::1111 {
        policy random
        tls_servername cloudflare-dns.com
        health_check 5s
    }
}
